# Paid Robinhood mainnet RPC used by server-side creator verification only. Keep the API key secret:
# never prefix this with VITE_ or commit a real value. Public RPC is the fallback when unset.
# ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<secret-key>
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/<secret-key>

# --- Pinata PINNING (server-side only; the /api/pin-image route pins launch images here) ---
# This is a SECRET — never prefix with VITE_ (that would bundle it into public client JS).
# Set in Vercel env, not here. A scoped Pinata API-key JWT with pinFileToIPFS permission.
# PINATA_JWT=...
# Optional endpoint override. Default = the proven classic pinning API
# (https://api.pinata.cloud/pinning/pinFileToIPFS). Set to https://uploads.pinata.cloud/v3/files to use
# Pinata's v3 upload API instead (the adapter parses both response shapes; no code change needed):
# PINATA_PIN_ENDPOINT=

# --- KV store (Upstash Redis REST) — REQUIRED for /api/pin-image + /api/launch-meta ---
# Our server code (api/_kv.js, api/_ratelimit.js) talks the Upstash REST API (`${URL}/pipeline`),
# NOT a raw redis:// TCP socket. It reads EXACTLY these two names — both endpoints fail CLOSED (503)
# until both are present. Upstash's Vercel integration provisions them automatically.
# NOTE: a plain "Redis" (TCP) integration that only exposes `REDIS_URL` will NOT work — if that's what
# you connected, copy its REST URL/token into these two, or add the Upstash (serverless Redis) integration.
# Upstash's own integration names them UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN — the code
# accepts those as aliases (KV_* takes precedence), so either name pair works with no remapping.
# KV_REST_API_URL=https://<name>.upstash.io
# KV_REST_API_TOKEN=...
# Optional pin rate-limit tuning (defaults: 20 uploads / 3600s per IP):
# PIN_RATE_LIMIT=20
# PIN_RATE_WINDOW_SEC=3600
