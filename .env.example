# Hydeout app environment (Vite). Copy to `.env.local` and adjust. Do NOT commit real secrets.

# IPFS read gateway used to display `ipfs://<CID>/<path>` token art (display-only; no pinning).
# Rewrites `ipfs://<CID>/<path>` → `${VITE_IPFS_GATEWAY}<CID>/<path>`, monogram fallback on failure.
# Defaults to https://ipfs.io/ipfs/ when unset. Must end with `/ipfs/` (trailing slash optional).
# clint's Pinata dedicated gateway (23709) — set this SAME value in Vercel env for prod builds.
# Pinning + display are the same provider (Pinata), so every pinned launch image resolves here.
VITE_IPFS_GATEWAY=https://amaranth-successive-landfowl-864.mypinata.cloud/ipfs/

# --- Paid browser RPC (Alchemy) ---
# Alchemy Core RPC supports Hydeout's enabled networks. This value is compiled into the browser
# bundle, so treat it as a public client credential: use a dedicated production app/key and configure
# Alchemy Security → Domain Allowlist for every exact production/preview origin. Rotate immediately if
# the key is ever pasted into chat, logs, screenshots, or source control.
# VITE_ALCHEMY_API_KEY=<replacement-key>
#
# Optional full endpoint overrides. Each takes precedence over VITE_ALCHEMY_API_KEY for its chain.
# The app always keeps the chain-owned public RPC as a second transport/fallback.
# VITE_ROBINHOOD_MAINNET_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<replacement-key>
# VITE_STABLE_MAINNET_RPC_URL=https://stable-mainnet.g.alchemy.com/v2/<replacement-key>
# VITE_ARBITRUM_MAINNET_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/<replacement-key>
# Optional Arc override. Defaults to the public Blockdaemon endpoint when unset.
# VITE_ARC_MAINNET_RPC_URL=https://rpc.blockdaemon.mainnet.arc.io

