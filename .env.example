# Hydeout app environment (Vite). Copy to `.env.local` and adjust. Do NOT commit real secrets.

# IPFS read gateway used to display `ipfs://<CID>/<path>` token art (display-only; no pinning).
# Rewrites `ipfs://<CID>/<path>` → `${VITE_IPFS_GATEWAY}<CID>/<path>`, monogram fallback on failure.
# Defaults to https://ipfs.io/ipfs/ when unset. Must end with `/ipfs/` (trailing slash optional).
# clint's Filebase dedicated gateway (21183) — set this same value in Vercel env for prod builds.
VITE_IPFS_GATEWAY=https://inland-fuchsia-dove.myfilebase.com/ipfs/

# --- Filebase PINNING (server-side only; needed only if the pin-on-launch route is built) ---
# These are SECRETS — never prefix with VITE_ (that would bundle them into public client JS).
# Set in Vercel env, not here. FILEBASE_KEY=... FILEBASE_SECRET=... FILEBASE_BUCKET=...
