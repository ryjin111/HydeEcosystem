# Persistent Postgres used by Ponder. Railway can inject this from an attached
# PostgreSQL service; locally, point it at your own database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hydeout

# Required for a local `npm start`. Railway supplies a deployment-specific
# schema through the start command in railway.json.
DATABASE_SCHEMA=hydeout_v5

# Production RPCs are strongly recommended. Public endpoints remain as
# fallbacks so local codegen and development can start without secrets.
PONDER_RPC_URL_988=https://your-stable-rpc.example
PONDER_RPC_URL_42161=https://your-arbitrum-rpc.example
PONDER_RPC_URL_4663=https://your-robinhood-rpc.example
PONDER_RPC_URL_57073=https://your-ink-rpc.example
